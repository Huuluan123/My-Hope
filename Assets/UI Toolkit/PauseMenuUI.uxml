                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:17d9da7d471350e4e8a5244f46e88ff6" entry="Id(10744889344)"/>
                </Bindings>
            </ui:Button>
            <ui:Button text="Options" name="btn-options" class="pause-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:17d9da7d471350e4e8a5244f46e88ff6" entry="Id(57259720704)"/>
                </Bindings>
            </ui:Button>
            <ui:Button text="Save &amp; Exit" name="btn-exit" class="pause-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:17d9da7d471350e4e8a5244f46e88ff6" entry="Id(80970121216)"/>
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
