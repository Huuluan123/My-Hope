/* 1. TRẠNG THÁI GỐC (KHI HIỂN THỊ ĐẦY ĐỦ) */
.dialogue-box-animated {
    /* Đứng yên tại vị trí gốc */
    translate: 0px 0px; 
    opacity: 1;
    scale: 1 1;
    
    /* Tăng độ bo góc lên 25px để trông giống một cái khung thông báo mềm mại của iOS/Android */
    border-radius: 25px; 
    
    transition-property: translate, opacity, scale; 
    transition-duration: 0.4s;
    /* Phép màu ở đây: ease-out-back sẽ làm hộp thoại rơi xuống lố một chút rồi nảy ngược lại vào vị trí */
    transition-timing-function: ease-out-back; 
}

/* 2. TRẠNG THÁI ẨN (KHI BIẾN MẤT) */
.dialogue-hidden {
    /* Trục X là 0, Trục Y là -300px -> Kéo ngược cái hộp lên trên trần nhà giấu đi */
    translate: 0px -300px; 
    opacity: 0;
    scale: 0.1 1; /* Thu nhỏ chiều rộng để tạo hiệu ứng biến mất mờ dần về phía trục X */
    
    transition-duration: 0.25s;
    /* Khi biến mất thì trượt ngược lên trên thật dứt khoát */
    transition-timing-function: ease-in; 
}

.choice-button {
    background-color: rgba(0, 0, 0, 0.6);
    color: rgb(242, 188, 140);
    border-left-color: rgb(242, 188, 140);
    border-left-width: 4px;
    border-top-width: 0; border-right-width: 0; border-bottom-width: 0;
    font-size: 18px;
    -unity-font-style: bold;
    padding: 10px 15px;
    margin-bottom: 5px;
    transition: scale 0.15s ease-out-bounce, background-color 0.15s;
    align-self: flex-start;
    border-radius: 4px;
}

.choice-button:hover, .choice-button:focus {
    background-color: rgba(242, 188, 140, 0.9);
    color: rgb(0, 0, 0);
    scale: 1.05;
}

.skip-container {
    position: absolute;

    bottom: 15px; /* Cách cạnh dưới của hộp thoại 15px (tạo khoảng hở) */
    right: 20px;  /* Cách cạnh phải của hộp thoại 20px (tạo khoảng hở) */

    width: auto;   /* Co giãn theo độ dài của chữ ("Hold C to Skip") */
    height: auto;  /* Co giãn theo chiều cao văn bản */
    
    flex-direction: row; 
    align-items: center;  /* Căn giữa văn bản và icon nút theo chiều dọc */
    justify-content: flex-end; /* Ép toàn bộ cụm dính vào cạnh phải của CHÍNH container này */

    padding: 8px 12px;
    border-radius: 10px; /* Bo góc nhẹ */
}